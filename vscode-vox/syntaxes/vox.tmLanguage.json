{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Vox",
    "scopeName": "source.vox",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "comments": {
            "match": "//.*$",
            "name": "comment.line.vox"
        },
        "strings": {
            "begin": "\"",
            "end": "\"",
            "name": "string.quoted.double.vox"
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(fn|let|mut|return|if|else|while|for|break|continue|match|new|struct|enum|extern|as|sizeof|const|static|mod|true|false|free)\\b",
                    "name": "keyword.control.vox"
                }
            ]
        },
        "types": {
            "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|char|bool|str|void)\\b",
            "name": "storage.type.vox"
        },
        "constants": {
            "match": "\\b[A-Z][A-Z0-9_]*\\b",
            "name": "constant.other.vox"
        },
        "operators": {
            "match": "->|[+\\-*/%=!<>&|.]+|:",
            "name": "keyword.operator.vox"
        },
        "numbers": {
            "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
            "name": "constant.numeric.vox"
        }
    }
}