// === Vox Prelude: C 标准函数声明 ===
// 编译器自动 #include <stdio.h> <stdlib.h> <string.h>
// extern fn 仅供 Vox 类型检查，不会生成 C 声明（避免与标准头文件冲突）

// 注意：printf / scanf 由编译器内置处理，不需在此声明

// ==================== stdio.h ====================
extern fn puts(s: str): i32;
extern fn getchar(): i32;

// 文件 I/O
extern fn fopen(path: str, mode: str): *void;
extern fn fclose(file: *void): i32;
extern fn fgetc(file: *void): i32;
extern fn fputc(c: i32, file: *void): i32;
extern fn fgets(s: str, n: i32, file: *void): str;
extern fn fputs(s: str, file: *void): i32;
extern fn fread(ptr: *void, size: u64, nmemb: u64, file: *void): u64;
extern fn fwrite(ptr: *void, size: u64, nmemb: u64, file: *void): u64;
extern fn fseek(file: *void, offset: i64, whence: i32): i32;
extern fn ftell(file: *void): i64;
extern fn rewind(file: *void): void;
extern fn fflush(file: *void): i32;
extern fn feof(file: *void): i32;
extern fn ferror(file: *void): i32;
extern fn perror(s: str): void;
extern fn remove(path: str): i32;
extern fn rename(oldpath: str, newpath: str): i32;

// ==================== stdlib.h ====================
// 内存
extern fn malloc(size: u64): *void;
extern fn calloc(nmemb: u64, size: u64): *void;
extern fn realloc(ptr: *void, size: u64): *void;
extern fn free(ptr: *void): void;

// 转换
extern fn atoi(s: str): i32;
extern fn atol(s: str): i64;
extern fn atof(s: str): f64;
extern fn strtol(s: str, endptr: str, base: i32): i64;
extern fn strtoul(s: str, endptr: str, base: i32): u64;
extern fn strtod(s: str, endptr: str): f64;

// 工具
extern fn abs(n: i32): i32;
extern fn rand(): i32;
extern fn srand(seed: u32): void;
extern fn system(cmd: str): i32;
extern fn exit(code: i32): void;

// ==================== string.h ====================
// 内存操作
extern fn memcpy(dst: *void, src: *void, n: u64): *void;
extern fn memmove(dst: *void, src: *void, n: u64): *void;
extern fn memset(s: *void, c: i32, n: u64): *void;
extern fn memcmp(a: *void, b: *void, n: u64): i32;
extern fn memchr(s: *void, c: i32, n: u64): *void;

// 字符串长度
extern fn strlen(s: str): u64;

// 字符串复制
extern fn strcpy(dst: str, src: str): str;
extern fn strncpy(dst: str, src: str, n: u64): str;

// 字符串拼接
extern fn strcat(dst: str, src: str): str;
extern fn strncat(dst: str, src: str, n: u64): str;

// 字符串比较
extern fn strcmp(a: str, b: str): i32;
extern fn strncmp(a: str, b: str, n: u64): i32;
extern fn strcoll(a: str, b: str): i32;

// 字符串查找
extern fn strchr(s: str, c: i32): str;
extern fn strrchr(s: str, c: i32): str;
extern fn strspn(s: str, accept: str): u64;
extern fn strcspn(s: str, reject: str): u64;
extern fn strpbrk(s: str, accept: str): str;
extern fn strstr(haystack: str, needle: str): str;
extern fn strtok(s: str, delim: str): str;

// 其他
extern fn strerror(errnum: i32): str;

